# ────────────────────────────────────────────────────────────────
# Supabase: Postgres + Auth
# ────────────────────────────────────────────────────────────────

# Settings → Database → Connection string → URI → modo Transaction (puerto 6543)
# Sustituye [YOUR-PASSWORD] por la password real del proyecto.
DATABASE_URL=postgres://postgres.xxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co

# Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ────────────────────────────────────────────────────────────────
# Cron secret (Vercel)
# ────────────────────────────────────────────────────────────────
# Protege /api/sync cuando lo dispara el cron diario.
# Genera con: openssl rand -hex 32
CRON_SECRET=


# ────────────────────────────────────────────────────────────────
# SharePoint (Microsoft Graph, device code flow)
# ────────────────────────────────────────────────────────────────
# Refresh token obtenido tras la primera ejecución de `npm run sync`.
# Si está vacío, /api/sync devuelve 200 'skipped' (cron no-op) y `npm run sync`
# disparará el device code flow para obtenerlo.
SHAREPOINT_REFRESH_TOKEN=

# Escape hatch para tests: token de acceso directo (omite todo el OAuth).
# SHAREPOINT_ACCESS_TOKEN=
